create table packs (id uuid primary key, name text not null check (char_length(name) between 1 and 60), descr text not null default '' check (char_length(descr) <= 600), mc text not null default '' check (char_length(mc) <= 20), zip text not null, image text not null default '', size bigint not null default 0, created_at timestamptz not null default now());
create table reviews (id uuid primary key default gen_random_uuid(), pack_id text not null, name text not null default 'Anonym' check (char_length(name) <= 30), rating int not null default 0 check (rating between 0 and 5), text text not null default '' check (char_length(text) <= 800), created_at timestamptz not null default now());
create function is_admin() returns boolean language sql stable as $$ select auth.jwt()->>'email' = 'admin@starfalltxt.com' $$;
alter table packs enable row level security;
alter table reviews enable row level security;
grant select on packs to anon, authenticated;
grant insert, update, delete on packs to authenticated;
grant select, insert on reviews to anon, authenticated;
grant delete on reviews to authenticated;
create policy "alle sehen Packs" on packs for select using (true);
create policy "nur Admin aendert Packs" on packs for all to authenticated using (is_admin()) with check (is_admin());
create policy "alle sehen Bewertungen" on reviews for select using (true);
create policy "alle duerfen bewerten" on reviews for insert with check (true);
create policy "nur Admin loescht Bewertungen" on reviews for delete to authenticated using (is_admin());
insert into storage.buckets (id, name, public) values ('packs', 'packs', true);
create policy "alle laden Packs" on storage.objects for select using (bucket_id = 'packs');
create policy "Admin laedt hoch" on storage.objects for insert to authenticated with check (bucket_id = 'packs' and is_admin());
create policy "Admin loescht Dateien" on storage.objects for delete to authenticated using (bucket_id = 'packs' and is_admin());
